{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "name": "log-prompt",
            "type": "command",
            "command": "bash scripts/_pyrun.sh scripts/log_hook.py --tool=codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "name": "log-tool",
            "type": "command",
            "command": "bash scripts/_pyrun.sh scripts/log_hook.py --tool=codex",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f 'C:\\Users\\DELL\\.agents\\skills\\impeccable\\scripts\\impeccable' ] || 'C:\\Users\\DELL\\.agents\\skills\\impeccable\\scripts\\impeccable' hook",
            "commandWindows": "if exist \"C:\\\\Users\\\\DELL\\\\.agents\\\\skills\\\\impeccable\\\\scripts\\\\impeccable.cmd\" (\"C:\\\\Users\\\\DELL\\\\.agents\\\\skills\\\\impeccable\\\\scripts\\\\impeccable.cmd\" hook & exit /b)",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "name": "log-stop",
            "type": "command",
            "command": "bash scripts/_pyrun.sh scripts/log_hook.py --tool=codex",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f 'C:\\Users\\DELL\\.agents\\skills\\impeccable\\scripts\\impeccable' ] || 'C:\\Users\\DELL\\.agents\\skills\\impeccable\\scripts\\impeccable' hook",
            "commandWindows": "if exist \"C:\\\\Users\\\\DELL\\\\.agents\\\\skills\\\\impeccable\\\\scripts\\\\impeccable.cmd\" (\"C:\\\\Users\\\\DELL\\\\.agents\\\\skills\\\\impeccable\\\\scripts\\\\impeccable.cmd\" hook & exit /b)",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  }
}

      "html": "<section class=\"ds-proposal\"><div class=\"ds-proposal-content\"><h3>K? ho?ch ?? b?n th?ng nh?t</h3><p>?? xu?t s? b?, kh?ng ph?i ch? ??nh cho c? nh?n.</p><details><summary>C?ch t?nh, gi? ??nh v? ngu?n</summary><p>Mifflin?St Jeor ??c l??ng n?ng l??ng ngh?; nh?n h? s? v?n ??ng gi? ??nh. D? li?u th?c ph?m ch?a ki?m ch?ng.</p></details><p class=\"ds-proposal-note\">??ng ? ?? v?o k? ho?ch v? nh?t k?. B?n v?n c? th? ch?nh l?i sau; d? li?u ???c l?u tr?n thi?t b?.</p></div><div class=\"ds-proposal-agreement\"><button class=\"ds-proposal-approve\">??ng ? k? ho?ch</button><p>Mu?n thay ??i? Nh?n Vi b?n d??i ?? ?i?u ch?nh tr??c khi ??ng ?.</p></div></section>",
      "css": ".ds-proposal{font-family:'Be Vietnam Pro',sans-serif;color:var(--ink,#17233b);background:var(--white,#fff);border:1px solid var(--line,#e1e6ef);border-radius:18px;overflow:hidden}.ds-proposal-content{max-height:none;overflow:visible;padding:12px 24px 15px}.ds-proposal h3{margin:0;font-size:17px;font-weight:600;line-height:1.35;letter-spacing:-.02em}.ds-proposal-content>p{font-size:12px;color:var(--muted,#657088);line-height:1.85;margin:12px 0 0}.ds-proposal details{margin-top:18px;font-size:12px;color:var(--muted,#657088);line-height:1.65}.ds-proposal summary{cursor:pointer;font-weight:600;color:var(--ink,#17233b);padding:4px 0}.ds-proposal summary:focus-visible{outline:3px solid var(--blue,#2349d8);outline-offset:4px}.ds-proposal details p{margin:12px 0 0;line-height:1.85}.ds-proposal-content>.ds-proposal-note{color:var(--orange-ink,#993d12);background:var(--orange-light,#fff0e6);padding:12px;border-radius:8px;margin-bottom:8px}.ds-proposal-agreement{padding:15px 24px;background:var(--blue-light,#edf1ff);border-top:1px solid var(--line,#e1e6ef)}.ds-proposal-agreement p{font-size:12px;color:var(--muted,#657088);margin:10px 0 0;line-height:1.8}.ds-proposal-approve{font-family:'Be Vietnam Pro',sans-serif;display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:12px 20px;border:1px solid transparent;border-radius:10px;background:var(--blue,#2349d8);color:var(--white,#fff);font-size:13px;font-weight:600;line-height:1.65;cursor:pointer;transition:background .2s var(--ease,cubic-bezier(.16,1,.3,1))}.ds-proposal-approve:hover{background:var(--blue-deep,#1737af)}.ds-proposal-approve:focus-visible{outline:3px solid var(--blue,#2349d8);outline-offset:4px}"

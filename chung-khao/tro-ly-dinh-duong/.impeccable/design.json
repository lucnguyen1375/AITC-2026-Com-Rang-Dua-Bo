      "kind": "button",
      "refersTo": "button-primary",
      "description": "Cobalt next action with a darker hover.",
      "html": "<button class=\"ds-primary\">Gửi câu trả lời<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" width=\"17\" height=\"17\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-primary{font-family:'Be Vietnam Pro',sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:46px;padding:12px 20px;border-radius:10px;font-size:13px;font-weight:600;line-height:1.65;cursor:pointer;transition:background .2s var(--ease,cubic-bezier(.16,1,.3,1));background:var(--blue,#2349d8);color:var(--white,#fff);border:1px solid transparent}.ds-primary:hover:not(:disabled){background:var(--blue-deep,#1737af)}.ds-primary:focus-visible{outline:3px solid var(--blue,#2349d8);outline-offset:4px}.ds-primary:active:not(:disabled){background:var(--blue-deep,#1737af)}.ds-primary:disabled{cursor:not-allowed;opacity:.55}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Bordered supporting action, including retry.",
      "html": "<button class=\"ds-secondary\">Thử lại</button>",
      "css": ".ds-secondary{font-family:'Be Vietnam Pro',sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:46px;padding:12px 20px;border-radius:10px;font-size:13px;font-weight:600;line-height:1.65;cursor:pointer;transition:background .2s var(--ease,cubic-bezier(.16,1,.3,1));background:var(--white,#fff);color:var(--ink,#17233b);border:1px solid var(--line,#e1e6ef)}.ds-secondary:hover:not(:disabled){border-color:var(--blue,#2349d8);background:var(--blue-light,#edf1ff)}.ds-secondary:focus-visible{outline:3px solid var(--blue,#2349d8);outline-offset:4px}.ds-secondary:disabled{cursor:not-allowed;opacity:.55}"
    },
    {
      "name": "Text Action",
      "kind": "button",
      "description": "Quiet reset or secondary text action.",
      "html": "<button class=\"ds-text-action\">Bắt đầu lại</button>",
      "css": ".ds-text-action{font-family:'Be Vietnam Pro',sans-serif;display:inline-flex;align-items:center;min-height:44px;padding:8px 0;border:0;background:none;color:var(--blue,#2349d8);font-size:12px;font-weight:600;line-height:1.65;cursor:pointer;text-align:left}.ds-text-action:hover{text-decoration:underline;text-underline-offset:4px}.ds-text-action:focus-visible{outline:3px solid var(--blue,#2349d8);outline-offset:4px}"
    },
    {
      "name": "Generated Answer Field",
      "kind": "input",
      "refersTo": "input-ai",
      "description": "Readable entry for an AI-generated question.",
      "html": "<label class=\"ds-field-label\" for=\"ds-answer\">Bạn thường tập vào lúc nào?</label><input class=\"ds-answer\" id=\"ds-answer\" placeholder=\"Ví dụ: 18 giờ sau giờ làm\"/>",
      "css": ".ds-field-label{font-family:'Be Vietnam Pro',sans-serif;display:block;font-size:15px;font-weight:600;line-height:1.7;margin-bottom:12px;color:var(--ink,#17233b)}.ds-answer{font-family:'Be Vietnam Pro',sans-serif;width:100%;min-height:48px;border:1px solid #cdd5e4;border-radius:9px;padding:11px 12px;background:var(--white,#fff);color:var(--ink,#17233b);font-size:15px;line-height:1.65;caret-color:var(--blue,#2349d8);transition:border-color .2s}.ds-answer::placeholder{color:#737e95}.ds-answer:hover{border-color:#8b9ac1}.ds-answer:focus-visible{outline:3px solid var(--blue,#2349d8);outline-offset:4px}.ds-answer[aria-invalid=true]{border-color:var(--error,#b82f32)}"
    },
    {
      "name": "Active Desktop Navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Cobalt-tinted icon-and-label sidebar destination.",
      "html": "<nav class=\"ds-nav\"><button class=\"ds-nav-item\" aria-current=\"page\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M16 3v4M8 3v4M3 11h18\"/></svg><span>Kế hoạch</span></button></nav>",
      "css": ".ds-nav{width:74px}.ds-nav-item{font-family:'Be Vietnam Pro',sans-serif;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;width:100%;min-height:69px;padding:10px 4px;border:0;border-radius:12px;background:var(--blue-light,#edf1ff);color:var(--blue,#2349d8);font-size:11px;font-weight:500;line-height:1.65;cursor:pointer}.ds-nav-item:hover{background:var(--blue-light,#edf1ff)}.ds-nav-item:focus-visible{outline:3px solid var(--blue,#2349d8);outline-offset:4px}"
    },

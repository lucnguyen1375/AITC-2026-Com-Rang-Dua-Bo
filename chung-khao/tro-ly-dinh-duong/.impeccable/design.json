      "css": ".ds-options{display:flex;flex-wrap:wrap;gap:9px}.ds-option{font-family:'Be Vietnam Pro',sans-serif;display:inline-flex;align-items:center;justify-content:flex-start;min-height:46px;padding:11px 17px;border:1px solid #bccaf0;border-radius:8px;background:var(--white,#fff);color:var(--blue,#2349d8);font-size:14px;line-height:1.5;cursor:pointer}.ds-option:hover{background:var(--blue-light,#edf1ff);border-color:var(--blue,#2349d8)}.ds-option[aria-pressed=true]{background:var(--blue,#2349d8);color:var(--white,#fff);border-color:var(--blue,#2349d8)}.ds-option:focus-visible{outline:3px solid var(--blue,#2349d8);outline-offset:4px}"

    {
      "name": "Conversation Bubbles",
      "kind": "custom",
      "refersTo": "conversation-assistant",
      "description": "Asymmetric light assistant and cobalt user messages.",
      "html": "<div class=\"ds-conversation\"><div class=\"ds-message\"><span class=\"ds-message-avatar\">Vi</span><p class=\"ds-message-body\">Bạn có thể chọn nhanh hoặc trả lời theo cách của mình.</p></div><div class=\"ds-message ds-user\"><p class=\"ds-message-body\">Mình tập vào buổi chiều.</p></div></div>",
      "css": ".ds-conversation{font-family:'Be Vietnam Pro',sans-serif;color:var(--ink,#17233b)}.ds-message{display:flex;gap:8px;align-items:flex-start;margin-bottom:19px}.ds-message-avatar{flex-shrink:0;width:25px;height:25px;border-radius:8px;background:var(--blue-light,#edf1ff);color:var(--blue,#2349d8);font-size:10px;font-weight:700;display:grid;place-items:center;margin-top:5px}.ds-message-body{margin:0;background:#f1f4fa;padding:13px 14px;border-radius:0 13px 13px 13px;max-width:calc(100% - 33px);font-size:14px;line-height:1.85;overflow-wrap:anywhere}.ds-user{justify-content:flex-end}.ds-user .ds-message-body{background:var(--blue,#2349d8);color:var(--white,#fff);border-radius:13px 0 13px 13px}"
    },
    {
      "name": "Proposal Before Agreement",
      "kind": "custom",

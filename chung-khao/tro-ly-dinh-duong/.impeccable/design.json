      "html": "<section class=\"ds-card\"><h2>Hồ sơ của bạn</h2><p>Thông tin có thể điều chỉnh trước khi thống nhất kế hoạch.</p></section>",
      "css": ".ds-card{font-family:'Be Vietnam Pro',sans-serif;background:var(--white,#fff);color:var(--ink,#17233b);border:1px solid var(--line,#e1e6ef);border-radius:var(--radius,16px);padding:24px}.ds-card h2{margin:0;font-size:18px;font-weight:700;line-height:1.35;letter-spacing:-.025em}.ds-card p{margin:6px 0 0;color:var(--muted,#657088);font-size:12px;line-height:1.65}"
    },

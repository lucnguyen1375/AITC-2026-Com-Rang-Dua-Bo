# Copy to .env.local here, or keep using the repository root .env.
# Server-only: never prefix these variables with VITE_.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
# Existing THUCCHIEN_API_KEY / THUCCHIEN_BASE_URL / THUCCHIEN_MODEL also work.

# Khóa OpenAI dùng riêng cho trợ lý dinh dưỡng (chỉ backend đọc khóa này).
# Không dùng AI_LOG_API_KEY của cuộc thi để gọi chatbot.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Cấu hình ghi log cuộc thi, không liên quan tới chatbot.
AI_LOG_SERVER=https://live.thucchien.ai/api/ingest
AI_LOG_API_KEY=

# (Tuỳ chọn) Thư mục chứa log cục bộ. Mặc định .ai-log.
# AI_LOG_DIR=.ai-log
